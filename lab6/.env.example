# Copy to .env and fill in your local SQL Server login.
DB_USER=sa
DB_PASSWORD=replace-with-your-local-password
# Base64 of at least 32 random bytes; see the setup instructions in README.md.
JWT_SECRET=replace-with-generated-base64-key
# Optional, for a different SQL Server host/port:
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=OrchidJWTLab;encrypt=true;trustServerCertificate=true
